# Questly environment configuration. Copy to `.env` (or `.env.local`) and adjust.

# PostgreSQL connection string. Leave unset to use the embedded local database
# (PGlite, persisted to ./.data/pglite) — no setup required for development.
#
# Supabase: Connect → Connection string → "Session pooler" (port 5432), with
# your password. Avoid the transaction pooler (6543): parallel queries can hang.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: custom location for the embedded database (only used when DATABASE_URL is unset).
# QUESTLY_PGLITE_DIR=./.data/pglite

# --- Sign-in (required for any public deployment) ---------------------------
# Supabase → Project Settings → API. Both are read on the server only.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<anon / publishable key>
#
# Who may sign in (comma-separated). Nobody else can, even with a valid link.
# QUESTLY_ALLOWED_EMAILS=you@example.com
#
# Optional: your site's public URL, used in sign-in emails (otherwise taken
# from the request). Example: https://questly.vercel.app
# QUESTLY_SITE_URL=
#
# Without SUPABASE_URL/KEY Questly runs in local single-player mode. Production
# builds refuse that mode unless this is set (local testing only):
# QUESTLY_ALLOW_NO_AUTH=1
